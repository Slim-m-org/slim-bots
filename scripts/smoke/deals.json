{
  "ready_seconds": 8,
  "steps": [
    {"say": "!deals", "expect_contains": ["deals setup"], "timeout": 15},
    {"say": "!deals digest", "expect_contains": ["digest is off"], "timeout": 15},
    {"say": "!deals digest 30", "expect_contains": ["0 to 23"], "timeout": 15},
    {"say": "!deals digest on", "expect_contains": ["digest is on"], "timeout": 15},
    {"say": "!deals now", "expect_contains": ["deals setup"], "timeout": 15},
    {"say": "!pricewatch", "expect_contains": ["pricewatch"], "timeout": 15},
    {"say": "!pricewatch portal 2 cheap", "expect_contains": ["target price"], "timeout": 15, "pause": 4},
    {"say": "!pricewatch list", "expect_contains": ["no watches yet"], "timeout": 15, "pause": 4},
    {"say": "!pricewatch remove 999", "expect_contains": ["no watch"], "timeout": 15, "pause": 4}
  ]
}
